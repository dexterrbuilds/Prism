# Safe default: full live market analysis, no Telegram delivery.
DRY_RUN=true
EXCHANGE=binance
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
PORT=10000
# Wait 45 minutes after the complete watchlist scan.
SCAN_INTERVAL_SECONDS=2700
CANDLE_LIMIT=250
REQUEST_TIMEOUT_MS=15000
REQUEST_CONCURRENCY=3
REQUEST_RETRIES=3
SEND_WATCH_ALERTS=false
MINIMUM_VALID_SCORE=80
PIVOT_LEFT=3
PIVOT_RIGHT=3
ZONE_ATR_TOLERANCE=0.5
MAX_CHASE_ATR=0.75
LOG_LEVEL=INFO

# Required only when DRY_RUN=false.
TELEGRAM_BOT_TOKEN=
# Backward-compatible primary recipient.
TELEGRAM_CHAT_ID=
# Comma-separated DM/group IDs. IDs are de-duplicated with TELEGRAM_CHAT_ID.
TELEGRAM_CHAT_IDS=
