# Safe default: full live market analysis, no Telegram delivery.
DRY_RUN=true
EXCHANGE=binance
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
PORT=10000
# Wait 45 minutes after the complete watchlist scan.
SCAN_INTERVAL_SECONDS=2700
CANDLE_LIMIT=250
REQUEST_TIMEOUT_MS=15000
REQUEST_CONCURRENCY=3
REQUEST_RETRIES=3
SEND_WATCH_ALERTS=false
MINIMUM_VALID_SCORE=80
MINIMUM_ENTRY_SCORE=75
PIVOT_LEFT=3
PIVOT_RIGHT=3
ZONE_ATR_TOLERANCE=0.5
MAX_CHASE_ATR=0.75
# Lightweight batch-ticker monitoring while the 45-minute scanner is sleeping.
LIFECYCLE_MONITOR_SECONDS=60
# Dedicated 1H/15M/5M engine. Keep disabled until dry-run review is complete.
SCALP_ENABLED=false
SCALP_MINIMUM_SETUP_SCORE=80
SCALP_MINIMUM_ENTRY_SCORE=75
LOG_LEVEL=INFO
# Outcome storage. "auto" uses Postgres when DATABASE_URL exists, otherwise SQLite.
OUTCOME_BACKEND=auto
# Recommended on Railway: Supabase Session Pooler URI (port 5432), not the REST URL.
DATABASE_URL=
DATABASE_SCHEMA=prism
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=3
DATABASE_SSL_REQUIRE=true
# SQLite fallback for local development. Use a persistent-volume path if selected in production.
SIGNAL_DB_PATH=/tmp/prism_signals.db
SIGNAL_HISTORY_LIMIT=5000
# In dry-run, persist hypothetical lifecycle/MAE/MFE but never send Telegram.
DRY_RUN_TRACK_OUTCOMES=true

# Optional external quality filter. Deterministic hard rules remain authoritative.
AI_ANALYSIS_ENABLED=false
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_MODEL=
AI_ENDPOINT=
AI_TIMEOUT_SECONDS=8
AI_CACHE_SIZE=128

# Required only when DRY_RUN=false.
TELEGRAM_BOT_TOKEN=
# Backward-compatible primary recipient.
TELEGRAM_CHAT_ID=
# Comma-separated DM/group IDs. IDs are de-duplicated with TELEGRAM_CHAT_ID.
TELEGRAM_CHAT_IDS=
# Comma-separated channels. Use -100... IDs for private channels or @username for public channels.
TELEGRAM_CHANNEL_IDS=
